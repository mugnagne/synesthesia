# Clé API Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optionnel : remplace le modèle par défaut (claude-opus-5).
# claude-sonnet-5 est une alternative moins coûteuse par requête.
# CLAUDE_MODEL=claude-sonnet-5

# Optionnel : journal des requêtes (voir /journal). Sans ces deux variables,
# l'app fonctionne normalement, seul le journal reste vide/inaccessible.
# DATABASE_URL=              # fournie automatiquement par l'intégration Postgres de Vercel
# JOURNAL_PASSWORD=
